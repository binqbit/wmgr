/* wmgr: seed -> Ed25519 public key. Input seeds are generated by the host
   CSPRNG. This kernel contains no entropy source or deterministic key walk. */
__kernel void wmgr_ed25519_public_keys(
    __global const uchar *seeds,
    __global uchar *public_keys,
    const uint count)
{
    size_t index = get_global_id(0);
    if (index >= count) return;

    sha512_context hash;
    hash.length = 0;
    hash.curlen = 32;
    hash.state[0] = 0x6a09e667f3bcc908UL;
    hash.state[1] = 0xbb67ae8584caa73bUL;
    hash.state[2] = 0x3c6ef372fe94f82bUL;
    hash.state[3] = 0xa54ff53a5f1d36f1UL;
    hash.state[4] = 0x510e527fade682d1UL;
    hash.state[5] = 0x9b05688c2b3e6c1fUL;
    hash.state[6] = 0x1f83d9abfb41bd6bUL;
    hash.state[7] = 0x5be0cd19137e2179UL;
    for (int i = 0; i < 32; ++i) hash.buf[i] = seeds[index * 32 + i];

    uchar digest[64];
    sha512_final(&hash, digest);
    digest[0] &= 248;
    digest[31] &= 63;
    digest[31] |= 64;

    ge_p3 point;
    ge_scalarmult_base(&point, digest);
    uchar public_key[32];
    ge_p3_tobytes(public_key, &point);
    for (int i = 0; i < 32; ++i) public_keys[index * 32 + i] = public_key[i];
}
